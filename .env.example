# Which vision LLM to use for extraction.
# Accepted: anthropic | claude | google | gemini
AI_PROVIDER=gemini

# API key for the active provider.
#   anthropic/claude: get one at https://console.anthropic.com/
#   google/gemini:    get one at https://aistudio.google.com/apikey
AI_API_KEY=

# Optional: override the provider's HTTP endpoint (proxies / regional / Vertex).
# Defaults:
#   anthropic/claude: https://api.anthropic.com
#   google/gemini:    https://generativelanguage.googleapis.com
AI_API_URL=

# Optional: override the model id.
# Defaults (chosen for low latency):
#   anthropic/claude: claude-opus-4-7   (swap to claude-haiku-4-5 for speed)
#   google/gemini:    gemini-2.5-flash  (swap to gemini-2.5-pro for max accuracy)
AI_MODEL=

# Optional: thinking-token budget for Gemini 2.5 models.
#   0  = disabled (default; fastest)
#   -1 = automatic
#   N  = cap reasoning at N tokens
# Pro IGNORES 0; for Pro try AI_THINKING_BUDGET=256 to keep latency down.
# Ignored by Anthropic.
AI_THINKING_BUDGET=

# API server port.
PORT=3000

# DPI for PDF -> PNG rendering before sending to the LLM.
# 150 is fast and accurate for typical polarity tables; bump to 200-250
# for very dense or scanned drawings.
PDF_RENDER_DPI=150

# --- Legacy env vars (still honoured for back-compat) ---
# LLM_PROVIDER, ANTHROPIC_API_KEY, ANTHROPIC_MODEL, GOOGLE_API_KEY, GOOGLE_MODEL
